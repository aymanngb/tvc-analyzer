{
  "name": "tvc-analyzer",
  "version": "1.0.0",
  "description": "TVC Brief Analyzer — production breakdown tool",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "vite": "vite",
    "electron": "electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.silvergreenfilms.tvcanalyzer",
    "productName": "TVC Brief Analyzer",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/logo.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "TVC Brief Analyzer",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "npmRebuild": true
  }
}
